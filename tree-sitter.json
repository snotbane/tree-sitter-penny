{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "penny",
      "camelcase": "Penny",
      "title": "Penny",
      "scope": "source.penny",
      "file-types": [
        "penny",
        "pen"
      ],
      "injection-regex": "^penny$",
      "class-name": "TreeSitterPenny"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Unlicense",
    "description": "Penny grammar for tree-sitter",
    "authors": [
      {
        "name": "Sebastian Weaver",
        "email": "snotbane@pm.me",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/snotbane/tree-sitter-penny",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}