{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "penny",
  "word": "identifier",
  "rules": {
    "keyword": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "await"
        },
        {
          "type": "STRING",
          "value": "pass"
        },
        {
          "type": "STRING",
          "value": "return"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z_][a-z_0-9]*",
      "flags": "i"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "\\d+"
          },
          {
            "type": "PATTERN",
            "value": "\\d+\\.\\d+"
          },
          {
            "type": "PATTERN",
            "value": "\\.\\d+"
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}