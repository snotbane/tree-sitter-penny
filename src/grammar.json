{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "penny",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_statement"
      }
    },
    "_statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "statement_assign"
        },
        {
          "type": "SYMBOL",
          "name": "_statement_path"
        },
        {
          "type": "SYMBOL",
          "name": "statement_dialog"
        },
        {
          "type": "SYMBOL",
          "name": "statement_dialog_close"
        },
        {
          "type": "SYMBOL",
          "name": "statement_label"
        },
        {
          "type": "SYMBOL",
          "name": "statement_print"
        },
        {
          "type": "SYMBOL",
          "name": "statement_return"
        }
      ]
    },
    "statement_assign": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "path"
        },
        {
          "type": "SYMBOL",
          "name": "assigner"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "statement_dialog": {
      "type": "SYMBOL",
      "name": "_string"
    },
    "statement_dialog_close": {
      "type": "PATTERN",
      "value": "-+"
    },
    "statement_label": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_keyword_label"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "_statement_path": {
      "type": "SYMBOL",
      "name": "path"
    },
    "statement_print": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_keyword_print"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "statement_return": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_keyword_return"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "expression"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        }
      ]
    },
    "_keyword": {
      "type": "PREC",
      "value": 100,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_keyword_await"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_call"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_elif"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_else"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_exit"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_if"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_init"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_jump"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_label"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_let"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_match"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_menu"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_new"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_object"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_pass"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_print"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_return"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_suspend"
          },
          {
            "type": "SYMBOL",
            "name": "_keyword_var"
          }
        ]
      }
    },
    "_keyword_await": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "await"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_call": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "call"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_elif": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "elif"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_else": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "else"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_exit": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "exit"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_if": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "if"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_init": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "init"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_jump": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "jump"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_label": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "label"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_let": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "let"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_match": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "match"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_menu": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "menu"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_new": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "new"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_object": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "object"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_pass": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "pass"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_print": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "print"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_return": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "return"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_suspend": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "suspend"
      },
      "named": true,
      "value": "keyword"
    },
    "_keyword_var": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "var"
      },
      "named": true,
      "value": "keyword"
    },
    "path": {
      "type": "PREC_RIGHT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_operator_dot"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "SYMBOL",
            "name": "identifier"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_operator_dot"
                },
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                }
              ]
            }
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z_][a-z_0-9]*",
      "flags": "i"
    },
    "assigner": {
      "type": "PATTERN",
      "value": "[+\\-\\*\\/?&]?="
    },
    "operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_operator_and"
        },
        {
          "type": "SYMBOL",
          "name": "_operator_angle_right"
        },
        {
          "type": "SYMBOL",
          "name": "_operator_dot"
        },
        {
          "type": "SYMBOL",
          "name": "_operator_or"
        },
        {
          "type": "SYMBOL",
          "name": "_operator_nand"
        },
        {
          "type": "SYMBOL",
          "name": "_operator_nor"
        },
        {
          "type": "PATTERN",
          "value": "[=!<>]=|[+\\-\\*\\/%&|<()]"
        }
      ]
    },
    "_operator_and": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "&&"
        },
        {
          "type": "STRING",
          "value": "and"
        }
      ]
    },
    "_operator_angle_right": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": ">"
      },
      "named": true,
      "value": "operator"
    },
    "_operator_dot": {
      "type": "ALIAS",
      "content": {
        "type": "STRING",
        "value": "."
      },
      "named": true,
      "value": "operator"
    },
    "_operator_or": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "||"
        },
        {
          "type": "STRING",
          "value": "or"
        }
      ]
    },
    "_operator_nand": {
      "type": "STRING",
      "value": "nand"
    },
    "_operator_nor": {
      "type": "STRING",
      "value": "nor"
    },
    "_string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "string_rich"
        },
        {
          "type": "SYMBOL",
          "name": "string_raw"
        }
      ]
    },
    "string_rich": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": "[>+]"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_string_rich_implicit"
                },
                {
                  "type": "BLANK"
                }
              ]
            }
          ]
        },
        {
          "type": "PATTERN",
          "value": "[`]{3}.*?[`]{3}|[`].*?[`]"
        }
      ]
    },
    "string_raw": {
      "type": "PATTERN",
      "value": "['\"]{3}.*?['\"]{3}|['\"].*?['\"]"
    },
    "number": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "\\d+"
        },
        {
          "type": "PATTERN",
          "value": "\\d+\\.\\d+"
        },
        {
          "type": "PATTERN",
          "value": "\\.\\d+"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "PATTERN",
          "value": ".*"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "_line_indent"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_string_rich_implicit"
    },
    {
      "type": "SYMBOL",
      "name": "_line_indent"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}