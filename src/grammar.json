{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "penny",
  "rules": {
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z_][a-z_0-9]+",
      "flags": "i"
    },
    "number": {
      "type": "PATTERN",
      "value": "\\d+(\\.\\d*)?|\\.\\d+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}